<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="main.cs" />
    <Compile Remove="MonteCarlo.Tests/**/*.cs" />
    <Compile Remove="MonteCarlo.Web/**/*.cs" />
    <Compile Remove="MonteCarlo.Core/**/*.cs" />
    <None Remove="MonteCarlo.Tests/**/*.cs" />
    <None Remove="MonteCarlo.Web/**/*.cs" />
    <None Remove="MonteCarlo.Core/**/*.cs" />
  </ItemGroup>
</Project>
